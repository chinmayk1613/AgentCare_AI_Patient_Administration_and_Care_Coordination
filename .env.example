# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Backend (copy relevant values to backend/.env)
APP_ENV=development
DATABASE_URL=sqlite:///./data/agentcare.db
JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_AGENT_MODEL=gpt-5.6-terra
# Optional: set only to a validated ft:* model ID after de-identified evals pass.
OPENAI_FINE_TUNED_MODEL=
LLM_ENABLED=false
WRITE_TOOLS_ENABLED=true
